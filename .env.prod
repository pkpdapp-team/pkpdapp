DEBUG=1
HOST_NAME=monkshood
SECRET_KEY=aLargeRandomSecretKey
DATABASE_URL=postgres://postgres:sekret2@postgres:5432/postgres


AUTH_LDAP_USE=0
AUTH_LDAP_SERVER_URI=ldap://ldap.forumsys.com:389 

AUTH_LDAP_DIRECT_BIND=1
AUTH_LDAP_BIND_DN_TEMPLATE=uid=%(user)s,dc=example,dc=com

AUTH_LDAP_BIND_DN=cn=read-only-admin,dc=example,dc=com
AUTH_LDAP_BIND_PASSWORD=password
AUTH_LDAP_SEARCH_BASE=ou=mathematicians,dc=example,dc=com
AUTH_LDAP_SEARCH_FILTER=(uid=%(user)s)

AUTH_LDAP_GROUP_SEARCH=ou=groups,dc=example,dc=com
AUTH_LDAP_USER_GROUP=cn=user,ou=groups,dc=example,dc=com
AUTH_LDAP_ADMIN_GROUP=cn=admin,ou=groups,dc=example,dc=com

# Enable signup functionality
ENABLE_SIGNUP=false
# Email/SMTP - required so the email-verification messages can be sent.
# If EMAIL_HOST is unset, emails are printed to the console (dev only).
# On AWS, point these at the Amazon SES SMTP endpoint.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Connection encryption: port 587 uses STARTTLS (EMAIL_USE_TLS=true, the
# default); port 465 uses implicit SSL (set EMAIL_USE_SSL=true instead). Only
# one may be true.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=webmaster@localhost

# Social login (django-allauth). Leave a provider's values blank to disable it.
# Register these OAuth redirect (callback) URIs with each provider:
#   https://<HOST_NAME>/accounts/google/login/callback/
#   https://<HOST_NAME>/accounts/github/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Frontend (Vite) build-time config ---
# These VITE_ variables are baked into the React build. The Dockerfile copies
# this file to frontend-v2/.env before `yarn build`, so this is the single
# source of truth for frontend prod config (frontend-v2/.env is used for local
# development only). VITE_ENABLE_SIGNUP should match the backend ENABLE_SIGNUP
# above.
VITE_ENABLE_SIGNUP=false
VITE_APP_ROCHE=false
VITE_APP_GA_ID=
VITE_APP_ACK_TXT=
VITE_APP_HELP_URL=https://github.com/pkpdapp-team/pkpdapp

# Chatbot / LLM (Portkey) configuration
# CHATBOT_BASE_URL and PORTKEY_API_KEY are required to enable the chatbot feature.
CHATBOT_MODEL=gpt-5-nano-2025-08-07
CHATBOT_BASE_URL=
PORTKEY_API_KEY=
