DEBUG=1
HOST_NAME=monkshood
SECRET_KEY=aLargeRandomSecretKey
DATABASE_URL=postgres://postgres:sekret2@postgres:5432/postgres


AUTH_LDAP_USE=0
AUTH_LDAP_SERVER_URI=ldap://ldap.forumsys.com:389 

AUTH_LDAP_DIRECT_BIND=1
AUTH_LDAP_BIND_DN_TEMPLATE=uid=%(user)s,dc=example,dc=com

AUTH_LDAP_BIND_DN=cn=read-only-admin,dc=example,dc=com
AUTH_LDAP_BIND_PASSWORD=password
AUTH_LDAP_SEARCH_BASE=ou=mathematicians,dc=example,dc=com
AUTH_LDAP_SEARCH_FILTER=(uid=%(user)s)

AUTH_LDAP_GROUP_SEARCH=ou=groups,dc=example,dc=com
AUTH_LDAP_USER_GROUP=cn=user,ou=groups,dc=example,dc=com
AUTH_LDAP_ADMIN_GROUP=cn=admin,ou=groups,dc=example,dc=com

# Enable signup functionality
ENABLE_SIGNUP=false
# Base URL that emailed verification links redirect back to after the address
# is confirmed. Must be the public https:// URL of the site in production.
FRONTEND_BASE_URL=https://monkshood

# Origins trusted for CSRF (comma-separated). Include the public https origin.
CSRF_TRUSTED_ORIGINS=https://monkshood

# Email/SMTP - required so the email-verification messages can be sent.
# If EMAIL_HOST is unset, emails are printed to the console (dev only).
# On AWS, point these at the Amazon SES SMTP endpoint.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Social login (django-allauth). Leave a provider's values blank to disable it.
# Register these OAuth redirect (callback) URIs with each provider:
#   https://<HOST_NAME>/accounts/google/login/callback/
#   https://<HOST_NAME>/accounts/github/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
